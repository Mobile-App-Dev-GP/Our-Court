<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#272727" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Check-In to Play"
            android:textColor="#272727"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Court Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_form_input"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_court_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dolores Park Courts"
                    android:textColor="#272727"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Join the community sign-up sheet."
                    android:textColor="#686868"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- When are you playing? -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="When are you playing?"
                android:textColor="#272727"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_date_today"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Today"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_date_tomorrow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Tomorrow"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_date_custom"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Date"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Time of day -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Time of day"
                android:textColor="#272727"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_time_morning"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Morning"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_time_afternoon"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Afternoon"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_time_evening"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Evening"
                    android:textAllCaps="false"
                    android:textColor="#272727"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#D4D4D4"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- What brings you to the court? -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="What brings you to the court?"
                android:textColor="#272727"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_play_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_form_input"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rb_casual_play"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:text="Casual Play"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E5E5" />

                <RadioButton
                    android:id="@+id/rb_looking_for_partner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingVertical="12dp"
                    android:text="Looking for Partner"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E5E5" />

                <RadioButton
                    android:id="@+id/rb_drills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:text="Drills"
                    android:textColor="#272727"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Match similar UTR/NTRP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Match similar UTR/NTRP"
                        android:textColor="#272727"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Find players around your skill level."
                        android:textColor="#686868"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_match_similar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Confirm Check-In Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_check_in"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#000000"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Confirm Check-In"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Courts are first come, first served. This is not a reservation."
        android:textColor="#686868"
        android:textSize="12sp" />

</LinearLayout>
