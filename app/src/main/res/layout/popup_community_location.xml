<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Local-board option -->
    <LinearLayout
        android:id="@+id/layout_local_board"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My local tennis board"
            android:textColor="#272727"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_local_board_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="San Francisco"
            android:textColor="#686868"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#DCDCDC" />

    <!-- Custom-location section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="6dp"
        android:text="Choose another location"
        android:textColor="#272727"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_zip_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_surface_tag"
            android:hint="Enter 5-digit ZIP code"
            android:inputType="number"
            android:maxLength="5"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_apply_zip"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#272727"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_zip_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="6dp"
        android:textColor="#D32F2F"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
