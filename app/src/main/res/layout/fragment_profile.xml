<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top App Bar -->
        <TextView
            android:id="@+id/tv_profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#272727"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="@id/tv_profile_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_profile_title" />

        <!-- Player Identity Row (Horizontal) -->
        <View
            android:id="@+id/view_avatar_bg"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_circle_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_title" />

        <TextView
            android:id="@+id/tv_avatar_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AR"
            android:textColor="#686868"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/view_avatar_bg"
            app:layout_constraintEnd_toEndOf="@id/view_avatar_bg"
            app:layout_constraintStart_toStartOf="@id/view_avatar_bg"
            app:layout_constraintTop_toTopOf="@id/view_avatar_bg" />

        <LinearLayout
            android:id="@+id/layout_identity_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/view_avatar_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_avatar_bg"
            app:layout_constraintTop_toTopOf="@id/view_avatar_bg">

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alex Rivera"
                android:textColor="#272727"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_location_join"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="San Francisco, CA · Joined May 2026"
                android:textColor="#686868"
                android:textSize="12sp" />

            <!-- Skill Badges Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_utr_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_surface_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="UTR 5.2"
                    android:textColor="#272727"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ntrp_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="NTRP 3.5"
                    android:textColor="#272727"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Edit Profile Outlined Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_profile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Edit Profile"
            android:textAllCaps="false"
            android:textColor="#272727"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_pencil"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#272727"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_avatar_bg"
            app:strokeColor="#D4D4D4"
            app:strokeWidth="1dp" />

        <!-- Collection Cards Group -->

        <!-- 1. Saved Courts Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_saved_courts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_edit_profile"
            app:strokeColor="#D4D4D4"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_saved_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Saved courts"
                    android:src="@drawable/ic_bookmark"
                    app:layout_constraintBottom_toBottomOf="@id/tv_saved_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_saved_title" />

                <TextView
                    android:id="@+id/tv_saved_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Saved Courts"
                    android:textColor="#272727"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/iv_saved_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_saved_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="0 courts"
                    android:textColor="#686868"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_saved_title"
                    app:layout_constraintEnd_toStartOf="@id/iv_saved_chevron"
                    app:layout_constraintTop_toTopOf="@id/tv_saved_title" />

                <ImageView
                    android:id="@+id/iv_saved_chevron"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="Open saved courts"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="@id/tv_saved_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_saved_title" />

                <View
                    android:id="@+id/divider_saved"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#D4D4D4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_saved_title" />

                <TextView
                    android:id="@+id/tv_saved_empty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No saved courts yet."
                    android:textColor="#686868"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_saved" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Hit List Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hit_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_saved_courts"
            app:strokeColor="#D4D4D4"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_hit_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Hit list"
                    android:src="@drawable/ic_list_checks"
                    app:layout_constraintBottom_toBottomOf="@id/tv_hit_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_hit_title" />

                <TextView
                    android:id="@+id/tv_hit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Hit List"
                    android:textColor="#272727"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/iv_hit_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_hit_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="0 courts"
                    android:textColor="#686868"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_hit_title"
                    app:layout_constraintEnd_toStartOf="@id/iv_hit_chevron"
                    app:layout_constraintTop_toTopOf="@id/tv_hit_title" />

                <ImageView
                    android:id="@+id/iv_hit_chevron"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="Open hit list"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="@id/tv_hit_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_hit_title" />

                <TextView
                    android:id="@+id/tv_hit_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your collection of unique courts played."
                    android:textColor="#686868"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hit_title" />

                <!-- Visibility Row -->
                <TextView
                    android:id="@+id/tv_visibility_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="List visibility"
                    android:textColor="#272727"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/layout_visibility_toggle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/layout_visibility_toggle" />

                <!-- Compact Public | Private Toggle -->
                <LinearLayout
                    android:id="@+id/layout_visibility_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_surface_tag"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_hit_desc">

                    <LinearLayout
                        android:id="@+id/layout_public"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle_avatar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="Globe"
                            android:src="@drawable/ic_globe" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Public"
                            android:textColor="#272727"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_private"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="Private"
                        android:textColor="#686868"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:id="@+id/divider_hit"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#D4D4D4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_visibility_toggle" />

                <TextView
                    android:id="@+id/tv_hit_empty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No courts played yet."
                    android:textColor="#686868"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_hit" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Court History Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_court_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_hit_list"
            app:strokeColor="#D4D4D4"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_history_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Court history"
                    android:src="@drawable/ic_history"
                    app:layout_constraintBottom_toBottomOf="@id/tv_history_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_history_title" />

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Court History"
                    android:textColor="#272727"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/iv_history_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_history_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="0 visits"
                    android:textColor="#686868"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_history_title"
                    app:layout_constraintEnd_toStartOf="@id/iv_history_chevron"
                    app:layout_constraintTop_toTopOf="@id/tv_history_title" />

                <ImageView
                    android:id="@+id/iv_history_chevron"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="Open court history"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="@id/tv_history_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_history_title" />

                <View
                    android:id="@+id/divider_history"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#D4D4D4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_history_title" />

                <TextView
                    android:id="@+id/tv_history_empty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No court visits yet."
                    android:textColor="#686868"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_history" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
