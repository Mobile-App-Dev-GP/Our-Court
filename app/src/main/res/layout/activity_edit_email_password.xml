<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Edit Email &amp; Password"
            android:textColor="#272727"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DCDCDC" />

    <!-- Scrollable Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- ================= SECURITY VERIFICATION SECTION ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security verification"
                android:textColor="#272727"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Enter your current password to verify your identity."
                android:textColor="#686868"
                android:textSize="12sp" />

            <!-- Current Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Current Password"
                android:textColor="#272727"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_current_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@drawable/bg_settings_card"
                    android:hint="Enter current password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_toggle_current_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Password Visibility"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_error_current_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9C5050"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ================= NEW ACCOUNT DETAILS SECTION ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="New account details"
                android:textColor="#272727"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- New Email Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="New Email Address"
                android:textColor="#272727"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_new_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_settings_card"
                android:hint="Enter new email address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="#272727"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_error_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9C5050"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- New Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="New Password"
                android:textColor="#272727"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_settings_card"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_toggle_new_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Password Visibility"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_error_new_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9C5050"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Confirm New Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Confirm New Password"
                android:textColor="#272727"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bg_settings_card"
                    android:hint="Re-enter new password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="#272727"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_toggle_confirm_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Password Visibility"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_error_confirm_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#9C5050"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Save Changes Button -->
            <Button
                android:id="@+id/btn_save_changes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_black_rounded_12dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
