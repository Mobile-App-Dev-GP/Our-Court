<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OurCourt" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#272727</item>
    </style>

    <style name="Theme.OurCourt" parent="Base.Theme.OurCourt" />

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.OurCourt.BottomNav" parent="">
        <item name="colorSecondaryContainer">#DCDCDC</item>
        <item name="colorOnSecondaryContainer">#272727</item>
    </style>
</resources>
